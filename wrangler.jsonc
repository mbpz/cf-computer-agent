{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-garden-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "KNOWLEDGE", "class_name": "KnowledgeBase" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KnowledgeBase"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOW_INSECURE_LOCAL": "false"
  },
  "observability": { "enabled": true }
}
