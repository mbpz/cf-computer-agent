{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./frontend/*"] },
    "jsx": "react-jsx",
    "lib": ["ES2022", "WebWorker", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "frontend/contracts/**/*.ts", "frontend/build-contract.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
